# Files that run on the Linux server must keep LF line endings, even when the repo is cloned on Windows
*.sh              text eol=lf
deploy/Caddyfile  text eol=lf
*.service         text eol=lf
*.path            text eol=lf
*.timer           text eol=lf
*.py              text eol=lf
# everything else: Git decides
*                 text=auto
*.svg             text
*.png             binary
deploy/*.conf      text eol=lf
