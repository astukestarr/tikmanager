# TikManager settings file. On a server the installer writes /etc/tikmanager/tikmanager.env for you; for local
# development copy this to .env next to server.py (or set the variables in your shell).
# Most settings an administrator changes live on the web pages (Admin > Settings, Branding, Integrations), not here.

# --- needed ---
TM_PUBLIC_URL=https://tikmanager.example.com     # the address users and routers reach (must match the HTTPS certificate)
TM_DATA=/var/lib/tikmanager                      # database, backups, logo, thumbnails
TM_KEY_FILE=/etc/tikmanager/master.key           # 32 random bytes; created on first run if missing. Keep it secret and backed up.
WG_SERVER_PUBKEY=                                # the controller's WireGuard public key (installer fills it in)

# --- usually left as they are ---
TM_HOST=127.0.0.1                                # listen address (Caddy in front; never 0.0.0.0 on a server)
TM_PORT=8800
TM_TRUSTED_PROXY=127.0.0.1                       # only this address may set X-Forwarded-For
WG_INTERFACE=wg0
WG_SERVER_IP=10.77.0.1
WG_NETWORK=10.77.0.0/16
TM_SYSLOG_PORT=5514

# --- one-time first-run link: https://<public address>/setup/<token> (dead once an administrator exists) ---
TM_SETUP_TOKEN=

# --- updates (Admin > Settings > Version & updates) ---
TM_UPDATE_REPO=astukestarr/tikmanager            # GitHub owner/repo new versions come from. The updater runs as root:
                                                 # only point this at a repository you trust (e.g. your own fork).
TM_UPDATE_CHECK=1                                # 0 = don't look for new versions daily (the button still works)

# --- optional defaults; Admin > Settings overrides them ---
TM_TECH_DOMAINS=                                 # e.g. example.com - email domains allowed to sign in as technicians
TM_TECH_ADMINS=                                  # e.g. you@example.com - become administrators at first sign-in
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
WG_ENDPOINT=                                     # default: <public address host>:51820
TM_PING_TARGET=1.1.1.1
TM_BACKUP_HOUR=2
TM_BACKUP_KEEP=10

# --- development only ---
TM_DEV=                                          # 1 = simulated routers + local dev sign-in (localhost only)
